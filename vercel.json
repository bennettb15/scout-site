{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/punch-list.js": {
      "includeFiles": "{node_modules/pdfkit/js/standard-fonts/**,public/Scout Only Logo Navy Dark NEW.png}"
    },
    "api/cron/account-deletion.js": {
      "maxDuration": 300
    },
    "api/account-deletion.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/verified",
      "destination": "/index.html"
    },
    {
      "source": "/reset-password",
      "destination": "/index.html"
    },
    {
      "source": "/accept-invite",
      "destination": "/index.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/index.html"
    },
    {
      "source": "/account",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms/service",
      "destination": "/index.html"
    },
    {
      "source": "/terms/software",
      "destination": "/index.html"
    },
    {
      "source": "/reports",
      "destination": "/index.html"
    },
    {
      "source": "/api/report-orgs",
      "destination": "/api/report-packages?mode=orgs"
    },
    {
      "source": "/api/portal-invite",
      "destination": "/api/admin/portal-access?mode=portalInvite"
    },
    {
      "source": "/punch-list",
      "destination": "/index.html"
    },
    {
      "source": "/punch-list/",
      "destination": "/index.html"
    },
    {
      "source": "/admin/portal-access",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/account-deletion",
      "schedule": "0 3 * * *"
    }
  ]
}
